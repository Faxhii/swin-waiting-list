# ─────────────────────────────────────────────────────────────
# SWIN Waitlist — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to git.
# ─────────────────────────────────────────────────────────────

# Google Sheets Webhook URL
# Paste your Google Apps Script Web App URL here.
# Every signup will instantly appear as a new row in your sheet.
# See: google-apps-script.js for setup instructions.
WEBHOOK_URL=

# BASE_COUNT: the number of real signups already in Google Sheets.
# Set this in Vercel → Settings → Environment Variables so the
# counter on the site never resets to 0 on cold starts.
# Example: BASE_COUNT=329
BASE_COUNT=0

# Server port (default: 3000)
PORT=3000
